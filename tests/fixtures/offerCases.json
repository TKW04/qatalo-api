{
  "version": 2,
  "description": "Casos de paridad del motor de ofertas v2. Mismo archivo en qatalo-web y qatalo-api. Por caso: se elige la ganadora entre `offers` sobre `items` (pickWinningOffer) y se reparte por línea (distributeDiscount). `expected.lines` va alineado con `items` (mismo orden). Montos a 2 decimales; `price` es el precio unitario descontado y se compara con tolerancia 0.01.",
  "cases": [
    {
      "name": "per_unit_200_x_5",
      "description": "RD$200 menos por cada rollo: 5 rollos = RD$1,000. La línea no elegible no se toca.",
      "offers": [
        { "offer_id": "o1", "name": "200 por rollo", "trigger": "automatic", "discount_type": "fixed", "fixed_mode": "per_unit", "discount_value": 200, "applies_to": "products", "product_ids": ["rollo"], "priority": "media" }
      ],
      "items": [
        { "line_id": "l1", "product_id": "rollo", "category_id": "c1", "price": 1500, "quantity": 5 },
        { "line_id": "l2", "product_id": "cinta", "category_id": "c1", "price": 300, "quantity": 1 }
      ],
      "expected": {
        "winner_offer_id": "o1",
        "total_discount": 1000,
        "lines": [
          { "line_id": "l1", "discount_amount": 1000, "price": 1300 },
          { "line_id": "l2", "discount_amount": 0, "price": 300 }
        ]
      }
    },
    {
      "name": "per_unit_tope_por_linea",
      "description": "per_unit 200 sobre una línea de 150 c/u: el descuento de la línea se topa en su subtotal (450), la otra línea recibe 200 x 2.",
      "offers": [
        { "offer_id": "o1", "name": "200 por unidad", "trigger": "automatic", "discount_type": "fixed", "fixed_mode": "per_unit", "discount_value": 200, "applies_to": "all", "priority": "media" }
      ],
      "items": [
        { "line_id": "l1", "product_id": "p1", "category_id": "c1", "price": 150, "quantity": 3 },
        { "line_id": "l2", "product_id": "p2", "category_id": "c1", "price": 500, "quantity": 2 }
      ],
      "expected": {
        "winner_offer_id": "o1",
        "total_discount": 850,
        "lines": [
          { "line_id": "l1", "discount_amount": 450, "price": 0 },
          { "line_id": "l2", "discount_amount": 400, "price": 300 }
        ]
      }
    },
    {
      "name": "order_min_quantity_4_no_aplica",
      "description": "Compra 5 rollos y llévate RD$100 en el total: con 4 rollos no aplica.",
      "offers": [
        { "offer_id": "o1", "name": "5 rollos = 100 off", "trigger": "automatic", "discount_type": "fixed", "fixed_mode": "order", "discount_value": 100, "applies_to": "products", "product_ids": ["rollo"], "min_quantity": 5, "priority": "media" }
      ],
      "items": [
        { "line_id": "l1", "product_id": "rollo", "category_id": "c1", "price": 1000, "quantity": 4 },
        { "line_id": "l2", "product_id": "cinta", "category_id": "c1", "price": 300, "quantity": 3 }
      ],
      "expected": {
        "winner_offer_id": null,
        "total_discount": 0,
        "lines": [
          { "line_id": "l1", "discount_amount": 0, "price": 1000 },
          { "line_id": "l2", "discount_amount": 0, "price": 300 }
        ]
      }
    },
    {
      "name": "order_min_quantity_5_aplica",
      "description": "Igual que el anterior con 5 rollos repartidos en dos variantes (3 + 2): aplica RD$100 una vez, repartido proporcional 60/40.",
      "offers": [
        { "offer_id": "o1", "name": "5 rollos = 100 off", "trigger": "automatic", "discount_type": "fixed", "fixed_mode": "order", "discount_value": 100, "applies_to": "products", "product_ids": ["rollo"], "min_quantity": 5, "priority": "media" }
      ],
      "items": [
        { "line_id": "l1", "product_id": "rollo", "variant_id": "blanco", "category_id": "c1", "price": 1000, "quantity": 3 },
        { "line_id": "l2", "product_id": "rollo", "variant_id": "negro", "category_id": "c1", "price": 1000, "quantity": 2 },
        { "line_id": "l3", "product_id": "cinta", "category_id": "c1", "price": 300, "quantity": 1 }
      ],
      "expected": {
        "winner_offer_id": "o1",
        "total_discount": 100,
        "lines": [
          { "line_id": "l1", "discount_amount": 60, "price": 980 },
          { "line_id": "l2", "discount_amount": 40, "price": 980 },
          { "line_id": "l3", "discount_amount": 0, "price": 300 }
        ]
      }
    },
